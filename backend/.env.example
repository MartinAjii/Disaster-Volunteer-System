# Server
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# JWT
JWT_SECRET=ganti_dengan_secret_panjang
JWT_EXPIRES_IN=1d

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=disaster_volunteer_db

# Firebase / Firestore
# Local:
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
# Cloud Run:
# gunakan service account Cloud Run dengan izin Firestore
FIREBASE_PROJECT_ID=your-firebase-project-id

# Alternatif jika ingin menyimpan service account dalam env:
# FIREBASE_SERVICE_ACCOUNT_BASE64=

# Opsional Google Cloud Storage untuk upload foto laporan
GOOGLE_CLOUD_STORAGE_BUCKET=
